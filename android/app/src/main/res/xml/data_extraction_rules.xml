<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves in Android's cloud backup or a device-to-device transfer.
     A copied database would come back stale over newer notes; Export notes
     is the way notes move. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
