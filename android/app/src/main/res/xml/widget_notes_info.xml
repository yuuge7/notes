<?xml version="1.0" encoding="utf-8"?>
<!-- The notes widget: 3 by 3 cells to begin with, as small as 2 by 2. It
     redraws when the app hands over new notes, never on a timer. Placing one
     asks what it shows, and its settings can change that later. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.ionel.notes.widgets.NotesWidgetSetup"
    android:description="@string/widget_notes_description"
    android:initialLayout="@layout/widget_notes"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_notes_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
