<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts, until Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind Flutter once it runs: the same ground, so nothing flashes
         between the launch screen and the first frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ground</item>
    </style>
</resources>
