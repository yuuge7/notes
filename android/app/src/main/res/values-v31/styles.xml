<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw the launch screen themselves: the icon on
         the app's ground. It follows the theme chosen in the app, which sets
         the app's night mode with UiModeManager. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ground</item>
    </style>
</resources>
