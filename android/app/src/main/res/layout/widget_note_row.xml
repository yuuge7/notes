<?xml version="1.0" encoding="utf-8"?>
<!-- One item on a note widget, before Android 12, which has no checkbox for a
     widget: the box as an image beside the words, open or ticked and muted.
     The row is the one target, described for TalkBack by NoteWidget. From
     Android 12, see layout-v31/widget_note_row.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/row_check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_press"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/row_box"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_box_open" />

        <TextView
            android:id="@+id/row_text"
            style="@style/WidgetText.NoteBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:paddingStart="10dp" />

        <TextView
            android:id="@+id/row_done"
            style="@style/WidgetText.NoteBody.Muted"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:paddingStart="10dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
