<?xml version="1.0" encoding="utf-8"?>
<!-- The new note widget at three cells: the four buttons, without the words. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_bar"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/capture_note"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:background="@drawable/widget_press"
            android:contentDescription="@string/widget_take_note"
            android:scaleType="center"
            android:src="@drawable/ic_widget_edit" />
        <ImageView
            android:id="@+id/capture_list"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:background="@drawable/widget_press"
            android:contentDescription="@string/widget_new_list"
            android:scaleType="center"
            android:src="@drawable/ic_widget_list" />
        <ImageView
            android:id="@+id/capture_photos"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:background="@drawable/widget_press"
            android:contentDescription="@string/widget_add_photos"
            android:scaleType="center"
            android:src="@drawable/ic_widget_image" />
        <ImageView
            android:id="@+id/capture_camera"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:background="@drawable/widget_press"
            android:contentDescription="@string/widget_take_photo"
            android:scaleType="center"
            android:src="@drawable/ic_widget_camera" />
    </LinearLayout>
</FrameLayout>
