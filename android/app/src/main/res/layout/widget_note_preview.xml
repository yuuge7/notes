<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows for the note widget on Android 12 and
     later: a sample list, two items left and two ticked off below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_page_moss"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/WidgetText.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_preview_list_title" />

            <TextView
                style="@style/WidgetText.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_list_progress"
                android:textAllCaps="true" />
        </LinearLayout>

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_widget_add" />
    </LinearLayout>

    <TextView
        style="@style/WidgetText.NoteBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:drawableStart="@drawable/ic_widget_box_open"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:text="@string/widget_preview_list_item_1" />

    <TextView
        style="@style/WidgetText.NoteBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_widget_box_open"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:text="@string/widget_preview_list_item_2" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@color/hairline" />

    <TextView
        style="@style/WidgetText.Meta.Strong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_widget_expand_more"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:text="@string/widget_preview_list_done"
        android:textAllCaps="true" />
</LinearLayout>
