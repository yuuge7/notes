<?xml version="1.0" encoding="utf-8"?>
<!-- The count the checked items fold under on a note widget, below a
     hairline, as in the editor. A tap folds them away or brings them back on
     this widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fold_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_press"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hairline"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <ImageView
            android:id="@+id/fold_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_widget_expand_more" />

        <TextView
            android:id="@+id/fold_label"
            style="@style/WidgetText.Meta.Strong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:textAllCaps="true" />
    </LinearLayout>
</LinearLayout>
