<?xml version="1.0" encoding="utf-8"?>
<!-- One note in the notes widget, drawn as its card in the grid: title, body
     or up to five checklist items, and a meta line. The whole card is one
     button for TalkBack, read from the note's description; what is inside is
     hidden from it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/note_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_card_graphite"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/note_title"
                style="@style/WidgetText.NoteTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/note_body"
                style="@style/WidgetText.NoteBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="5" />

            <TextView
                android:id="@+id/note_empty"
                style="@style/WidgetText.NoteBody.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_empty_note"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/note_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/note_box_1"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_widget_box_open" />

                <TextView
                    android:id="@+id/note_item_1"
                    style="@style/WidgetText.NoteBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/note_done_1"
                    style="@style/WidgetText.NoteBody.Muted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/note_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/note_box_2"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_widget_box_open" />

                <TextView
                    android:id="@+id/note_item_2"
                    style="@style/WidgetText.NoteBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/note_done_2"
                    style="@style/WidgetText.NoteBody.Muted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/note_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/note_box_3"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_widget_box_open" />

                <TextView
                    android:id="@+id/note_item_3"
                    style="@style/WidgetText.NoteBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/note_done_3"
                    style="@style/WidgetText.NoteBody.Muted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/note_row_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/note_box_4"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_widget_box_open" />

                <TextView
                    android:id="@+id/note_item_4"
                    style="@style/WidgetText.NoteBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/note_done_4"
                    style="@style/WidgetText.NoteBody.Muted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/note_row_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/note_box_5"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_widget_box_open" />

                <TextView
                    android:id="@+id/note_item_5"
                    style="@style/WidgetText.NoteBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/note_done_5"
                    style="@style/WidgetText.NoteBody.Muted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/note_more"
                style="@style/WidgetText.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/note_meta"
                style="@style/WidgetText.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingTop="8dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
