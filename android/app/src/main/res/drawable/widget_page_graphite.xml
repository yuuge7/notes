<?xml version="1.0" encoding="utf-8"?>
<!-- A note widget for a note with no colour: plain paper, with the
     launcher's corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/card" />
    <stroke android:width="1dp" android:color="@color/hairline" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
